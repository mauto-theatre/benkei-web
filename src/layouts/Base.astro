---
import "../styles/main.sass";
import conf from "../config/site.config.ts";
import Header from "../components/cmpHead.astro";
import Footer from "../components/cmpFoot.astro";

let title;
let description;
let noindex;

if (Astro.props.frontmatter) {
    const { frontmatter } = Astro.props;
    title = frontmatter.title;
    description = frontmatter.description ?? conf.description;
    noindex = frontmatter.noindex ?? false;
} else {
    title = Astro.props.title;
    description = Astro.props.description ?? conf.description;
    noindex = Astro.props.noindex ?? false;
}

let titlePrefixLines: string[] = [];
let titleMain = title;
const titleMatch = title?.match(/^(.*?)(『.*』)$/);
if (titleMatch) {
    titlePrefixLines = titleMatch[1].split("　").filter((line) => line.length > 0);
    titleMain = titleMatch[2];
}
---

<!DOCTYPE html>
<html lang="ja">
    <head>
        {noindex && <meta name="robots" content="noindex" />}
        <link rel="icon" href="/src/fav32.png">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta charset="UTF-8">
        <title>{title ? `${title}｜${conf.basetitle}` : conf.basetitle}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@400;500;700;900&display=swap" rel="stylesheet">

    </head>
    <body>
        <Header />
        <main>
            {title && (
                <h1>
                    {titlePrefixLines.length > 0 && (
                        <span class="title-prefix">
                            {titlePrefixLines.map((line) => (
                                <span class="title-prefix-line">{line}</span>
                            ))}
                        </span>
                    )}
                    <span class="title-main">{titleMain}</span>
                </h1>
              )}
            <slot />
        </main>
        <Footer />
    </body>
</html>

<script>
    document.querySelectorAll(".flyer-slider").forEach((slider) => {
        const slides = slider.querySelectorAll(".flyer-slide");
        if (slides.length < 2) return;

        const counter = document.createElement("div");
        counter.className = "flyer-counter";
        slider.insertAdjacentElement("afterend", counter);

        const update = () => {
            const width = slider.clientWidth || 1;
            const index = Math.round(slider.scrollLeft / width) + 1;
            const clamped = Math.min(Math.max(index, 1), slides.length);
            counter.textContent = `${clamped} / ${slides.length}`;
        };

        update();
        let ticking = false;
        slider.addEventListener("scroll", () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(() => {
                update();
                ticking = false;
            });
        }, { passive: true });
    });
</script>
